{
  "name": "live-photo-creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Create real Apple Live Photos (paired JPEG + MOV) entirely in your browser. Vue 3 + TypeScript + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "share-card": "node scripts/generate-share-card.mjs"
  },
  "dependencies": {
    "@fontsource/sora": "^5.2.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "mp4-muxer": "^5.2.1",
    "puppeteer-core": "^24.9.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.8"
  }
}
